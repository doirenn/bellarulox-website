{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/protocolo-uso-seguro/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    }
  ],
  "redirects": [
    { "source": "/arquitectura-b2b", "destination": "/operaciones/", "permanent": true },
    { "source": "/arquitectura-b2b/", "destination": "/operaciones/", "permanent": true },
    { "source": "/del-caos-al-foco", "destination": "/aprende/", "permanent": true },
    { "source": "/del-caos-al-foco/", "destination": "/aprende/", "permanent": true },
    { "source": "/del-caos-al-foco.html", "destination": "/aprende/", "permanent": true },
    { "source": "/recursos.html", "destination": "/recursos/", "permanent": true },
    { "source": "/sistemas", "destination": "/operaciones/", "permanent": true },
    { "source": "/sistemas/", "destination": "/operaciones/", "permanent": true },
    { "source": "/sistemas.html", "destination": "/operaciones/", "permanent": true }
  ]
}
