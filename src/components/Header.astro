---
import { BOOKING_URL, NAV } from '../data/site';

const path = Astro.url.pathname;

function active(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/"><img src="/assets/logo-fuscia.png" alt="Bellarulox" /></a>
    <nav class="nav" id="mobile-menu" aria-label="Principal">
      {
        NAV.map((item) => (
          <a href={item.href} class={active(item.href) ? 'on' : undefined} aria-current={active(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary nav-cta" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Agenda una llamada</a>
    </nav>
    <a class="btn btn-primary header-cta" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Agenda una llamada</a>
    <button class="menu-btn" id="mobile-menu-btn" type="button" aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-ready="1">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var nav = document.getElementById('mobile-menu');
    if (!btn || !nav) return;
    function setOpen(open) {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Menú');
    }
    btn.addEventListener('click', function () {
      setOpen(!nav.classList.contains('open'));
    });
    nav.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () { setOpen(false); });
    });
  })();
</script>
