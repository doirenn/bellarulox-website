---
import { KIT_FORM_PAGE, KIT_FORM_URL } from '../data/site';

interface Props {
  locale?: 'es' | 'en';
  labels?: { name: string; email: string; submit: string };
}
const { locale = 'es', labels } = Astro.props;
const name = labels?.name ?? 'Tu nombre';
const email = labels?.email ?? 'Tu correo';
const submit = labels?.submit ?? 'Suscribirme';
const copyOk = locale === 'en' ? 'Done. Check your email to confirm.' : 'Listo. Revisa tu correo para confirmar la suscripción.';
const copyBadName = locale === 'en' ? 'Write your name to subscribe.' : 'Escribe tu nombre para suscribirte.';
const copyBadEmail = locale === 'en' ? 'Check the email: the format is not valid.' : 'Revisa el correo: no tiene un formato válido.';
const copyFail = locale === 'en' ? 'I could not finish the subscription from here. You can open the Kit form.' : 'No pude completar la suscripción desde aquí. Puedes usar el formulario directo de Kit.';
const copyNet = locale === 'en' ? 'I could not send the form. Check your connection and try again.' : 'No pude enviar el formulario. Revisa tu conexión e inténtalo de nuevo.';
const copyOpen = locale === 'en' ? 'Open the form' : 'Abrir el formulario';
---

<!-- TODO Marian: confirmar si este formulario de Kit es el de «Un paso a la vez» o hace falta otra etiqueta. -->
<form class="form" id="newsletter-form" action={KIT_FORM_URL} method="post" novalidate>
  <label class="sr-only" for="nl-name">{name}</label>
  <input class="field" id="nl-name" name="fields[first_name]" type="text" placeholder={name} autocomplete="name" required />
  <label class="sr-only" for="nl-email">{email}</label>
  <input class="field" id="nl-email" name="email_address" type="email" placeholder={email} autocomplete="email" required />
  <button class="btn btn-dark" type="submit">{submit}</button>
  <p class="form-msg" id="nl-msg" role="status" hidden></p>
</form>

<script is:inline define:vars={{ KIT_FORM_PAGE, copyOk, copyBadName, copyBadEmail, copyFail, copyNet, copyOpen }}>
  (function () {
    var form = document.getElementById('newsletter-form');
    var msg = document.getElementById('nl-msg');
    if (!form || !msg) return;
    function show(text, ok) {
      msg.hidden = false;
      msg.textContent = text;
      msg.className = 'form-msg ' + (ok ? 'ok' : 'err');
    }
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var data = new FormData(form);
      var name = String(data.get('fields[first_name]') || '').trim();
      var email = String(data.get('email_address') || '').trim();
      if (!name) {
        show(copyBadName, false);
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        show(copyBadEmail, false);
        return;
      }
      var button = form.querySelector('button');
      if (button) button.disabled = true;
      fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (body) {
          return { ok: res.ok, body: body };
        });
      }).then(function (result) {
        if (result.ok && result.body && result.body.status === 'success') {
          form.reset();
          show(copyOk, true);
          return;
        }
        show(copyFail, false);
        if (!document.getElementById('nl-fallback')) {
          var link = document.createElement('a');
          link.id = 'nl-fallback';
          link.href = KIT_FORM_PAGE;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = copyOpen;
          link.style.display = 'inline-block';
          link.style.marginTop = '8px';
          link.style.fontWeight = '700';
          msg.insertAdjacentElement('afterend', link);
        }
      }).catch(function () {
        show(copyNet, false);
      }).finally(function () {
        if (button) button.disabled = false;
      });
    });
  })();
</script>
