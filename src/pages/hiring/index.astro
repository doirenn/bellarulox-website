---
import Base from '../../layouts/Base.astro';
import '../../styles/hiring.css';
import { KIT_FORM_PAGE } from '../../data/site';

const title = 'Hiring · Marian Montilla | Bellarulox';
const description = 'Publicaciones que otras personas dejan en Threads, reunidas para revisarlas. Se mantienen 14 días. Bellarulox no participa en los avisos.';
---

<Base title={title} description={description} path="/hiring/">
  <section class="phero">
    <div class="wrap">
      <div>
        <p class="crumb"><a href="/">Inicio</a> &nbsp;/&nbsp; <b>Hiring</b></p>
        <span class="eyebrow" data-es="Un feed para revisar" data-en="A feed to review">Un feed para revisar</span>
        <h1>Hiring</h1>
        <p class="lead" data-es="Publicaciones que otras personas dejan en Threads, reunidas en un solo lugar para revisarlas sin buscar una por una. Se mantienen 14 días y luego se borran." data-en="Posts other people publish on Threads, gathered in one place so you can review them without searching one by one. They stay for 14 days and are then removed.">Publicaciones que otras personas dejan en Threads, reunidas en un solo lugar para revisarlas sin buscar una por una. Se mantienen 14 días y luego se borran.</p>
        <p class="note"><span data-es="Esto es un feed curado. El contacto es con quien publicó." data-en="This is a curated feed. Contact the person who posted.">Esto es un feed curado. El contacto es con quien publicó.</span><br /><span data-es="Bellarulox no participa en el aviso y no lo verifica." data-en="Bellarulox is not part of the offer and does not verify it.">Bellarulox no participa en el aviso y no lo verifica.</span></p>
      </div>
    </div>
  </section>

  <section class="light" style="padding-top:48px">
    <div class="wrap">
      <div class="hiring-tools">
        <div class="lang-toggle" role="group" aria-label="Idioma">
          <button type="button" id="lang-es" aria-pressed="true">ES</button>
          <button type="button" id="lang-en" aria-pressed="false">EN</button>
        </div>
      </div>
      <div class="filters">
        <p class="updated" id="updated"></p>
        <div class="row" id="where"></div>
        <div class="row" id="contact"></div>
        <div class="row" id="pay"></div>
        <div class="row" id="language"></div>
        <div class="search-row">
          <label class="sr-only" for="q">Buscar</label>
          <input id="q" type="search" />
          <div>
            <span class="count" id="count"></span>
            <button type="button" class="clear" id="clear" hidden></button>
          </div>
        </div>
      </div>
      <div id="lista" class="jobs"></div>
      <nav class="pages" id="pages" aria-label="Páginas"></nav>
      <div class="oferta b" style="margin-top:36px">
        <p style="color:var(--crema)" data-es='Únete a mi newsletter "Un paso a la vez": una idea práctica cada semana para tu trabajo, tu negocio o tu día a día.' data-en='Join my newsletter "Un paso a la vez": one practical idea each week for your work, your business, or your day to day.'>Únete a mi newsletter "Un paso a la vez": una idea práctica cada semana para tu trabajo, tu negocio o tu día a día.</p>
        <a class="btn btn-primary" style="margin-top:18px;align-self:flex-start" href={KIT_FORM_PAGE} target="_blank" rel="noopener noreferrer" data-es="Unirme" data-en="Join">Unirme</a>
      </div>
    </div>
  </section>
</Base>

<script src="/hiring/hiring.js" is:inline></script>
