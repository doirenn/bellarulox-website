---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada | Bellarulox"
  description="Esta página no existe en bellarulox.com."
  path="/404/"
  noindex={true}
>
  <section class="phero">
    <div class="wrap">
      <div>
        <span class="eyebrow">404</span>
        <h1>Esta página no está.</h1>
        <p class="lead">El enlace puede haber cambiado. Vuelve al inicio o cuéntame qué buscabas.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/">Ir al inicio</a>
          <a class="btn btn-ghost" href="/que-te-encuentren/">Ver cómo te ayudo</a>
        </div>
      </div>
    </div>
  </section>
</Base>
