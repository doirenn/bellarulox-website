---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/frente.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { EMAIL, JOB_TITLE, SOCIALS } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const sameAs = SOCIALS.map((item) => item.href);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marian Montilla',
  url: 'https://bellarulox.com/',
  email: EMAIL,
  jobTitle: JOB_TITLE,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Manta',
    addressCountry: 'EC',
  },
  sameAs,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Montserrat:ital,wght@0,400;0,600;0,700;1,400&display=block"
      rel="stylesheet"
    />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="grain">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
